<Window x:Class="ImageSquareResizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageSquareResizer.Controls"
        Title="SquareResizer"
        Icon="Assets/app.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="2"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeModeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="MainContentRoot"
          Background="{DynamicResource WindowBackgroundBrush}"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <StackPanel Margin="12">
            <Border x:Name="DropArea"
                    Background="{DynamicResource DropAreaBackgroundBrush}"
                    BorderBrush="{DynamicResource DropAreaBorderBrush}"
                    BorderThickness="0"
                    CornerRadius="6"
                    AllowDrop="True"
                    DragEnter="OnDragEnter"
                    DragOver="OnDragOver"
                    DragLeave="OnDragLeave"
                    Drop="OnDrop"
                    Margin="0,0,0,12">
                <Grid x:Name="PreviewHost"
                      ClipToBounds="True"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      ContextMenuOpening="OnPreviewHostContextMenuOpening"
                      MouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                      MouseMove="OnPreviewMouseMove"
                      MouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CloseFileMenuItem"
                                      Header="Close file"
                                      Click="OnCloseFileMenuItemClick">
                                <MenuItem.Icon>
                                    <controls:SvgIcon Width="10"
                                                      Height="10"
                                                      Foreground="{DynamicResource MainTextBrush}"
                                                      Source="/Assets/Icons/close.svg" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <Image x:Name="PreviewImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="Fill"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />

                    <StackPanel x:Name="DropIdleContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="True">
                        <Button x:Name="SelectFileButton"
                                Width="134"
                                Height="26"
                                Content="Open file"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnOpenButtonClick" />
                        <TextBlock x:Name="DropOrTextBlock"
                                Margin="0,0,0,0"
                                Text="or"
                                TextAlignment="Center"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                FontWeight="SemiBold" />
                        <TextBlock x:Name="DropHereTextBlock"
                                Margin="0,5,0,0"
                                Text="drop it here"
                                TextAlignment="Center"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                FontWeight="SemiBold" />
                    </StackPanel>

                    <controls:SvgIcon x:Name="DropPlusIcon"
                                      Width="140"
                                      Height="140"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                      Source="/Assets/Icons/plus-outline.svg"
                                      Visibility="Collapsed"
                                      Opacity="0.55" />

                    <Canvas x:Name="CropCanvas"
                            Visibility="Collapsed"
                            Background="Transparent"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <Rectangle x:Name="CropOverlay"
                                   UseLayoutRounding="True"
                                   SnapsToDevicePixels="True"
                                   Fill="#220078D7"
                                   Width="100"
                                   Height="100"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropBorderTop"
                                   Fill="{DynamicResource AccentBorderBrush}"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="CropBorderRight"
                                   Fill="{DynamicResource AccentBorderBrush}"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="CropBorderBottom"
                                   Fill="{DynamicResource AccentBorderBrush}"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="CropBorderLeft"
                                   Fill="{DynamicResource AccentBorderBrush}"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />

                        <Line x:Name="CropCenterVerticalLine"
                              Stroke="{DynamicResource AccentBorderBrush}"
                              StrokeThickness="1"
                              StrokeDashArray="4 4"
                              Opacity="0.9"
                              IsHitTestVisible="False" />

                        <Line x:Name="CropCenterHorizontalLine"
                              Stroke="{DynamicResource AccentBorderBrush}"
                              StrokeThickness="1"
                              StrokeDashArray="4 4"
                              Opacity="0.9"
                              IsHitTestVisible="False" />

                        <Border x:Name="CropSizeBadge"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="5,2"
                                IsHitTestVisible="True"
                                MouseEnter="OnCropSizeBadgeMouseEnter"
                                MouseLeave="OnCropSizeBadgeMouseLeave">
                            <TextBlock x:Name="CropSizeTextBlock"
                                       Text="0×0"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </Border>

                        <Rectangle x:Name="CropHandleTopLeft"
                                   Width="9"
                                   Height="9"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleTopRight"
                                   Width="9"
                                   Height="9"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleBottomLeft"
                                   Width="9"
                                   Height="9"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleBottomRight"
                                   Width="9"
                                   Height="9"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleTopSide"
                                   Width="17"
                                   Height="7"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleRightSide"
                                   Width="7"
                                   Height="17"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleBottomSide"
                                   Width="17"
                                   Height="7"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="CropHandleLeftSide"
                                   Width="7"
                                   Height="17"
                                   Fill="{DynamicResource InputBackgroundBrush}"
                                   Stroke="{DynamicResource AccentBorderBrush}"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                    </Canvas>

                    <Rectangle x:Name="DropDashedBorder"
                               Margin="0.75"
                               RadiusX="6"
                               RadiusY="6"
                               Stroke="{DynamicResource DropAreaDashedBorderBrush}"
                               StrokeThickness="1.5"
                               StrokeDashArray="6 5"
                               StrokeDashCap="Round"
                               Fill="Transparent"
                               IsHitTestVisible="False" />

                </Grid>
            </Border>

            <Border x:Name="MainSettingsPanel"
                    Background="{DynamicResource DropAreaBackgroundBrush}"
                    BorderBrush="{DynamicResource DropAreaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    SizeChanged="OnMainSettingsPanelSizeChanged"
                    Margin="0,0,0,12">
                <Grid x:Name="SettingsRowsGrid"
                      MinWidth="311">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResizeModeLabel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Text="Size"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                    <ToggleButton x:Name="ResizeAutoButton"
                                  Grid.Row="0"
                                  Grid.Column="2"
                                  Height="26"
                                  Content="Auto"
                                  Tag="auto"
                                  Style="{StaticResource ResizeModeToggleButtonStyle}"
                                  Click="OnResizeModeButtonClick" />
                    <ToggleButton x:Name="ResizeCoverButton"
                                  Grid.Row="0"
                                  Grid.Column="4"
                                  Height="26"
                                  Content="Cover"
                                  Tag="music_cover"
                                  Style="{StaticResource ResizeModeToggleButtonStyle}"
                                  Click="OnResizeModeButtonClick" />

                    <TextBlock x:Name="QualityLabel"
                               Grid.Row="2"
                               Grid.Column="0"
                               Text="Quality"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                    <Grid Grid.Row="2"
                          Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QualityTextBox"
                                 Grid.Column="0"
                                 Width="70"
                                 Height="26"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 LostFocus="OnQualityLostFocus"
                                 TextChanged="OnQualityTextChanged"
                                 PreviewKeyDown="OnQualityPreviewKeyDown"
                                 PreviewTextInput="OnQualityPreviewTextInput"
                                 PreviewMouseWheel="OnQualityPreviewMouseWheel" />
                        <TextBlock x:Name="SharpModeLabel"
                                   Grid.Column="2"
                                   Text="Sharp"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12" />
                    </Grid>
                    <ComboBox x:Name="SharpModeComboBox"
                              Grid.Row="2"
                              Grid.Column="4"
                              Height="26"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              SelectionChanged="OnSharpModeSelectionChanged"
                              PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                        <ComboBoxItem Content="Standard" Tag="standard" />
                        <ComboBoxItem Content="Increased" Tag="increased" />
                        <ComboBoxItem Content="High" Tag="high" />
                        <ComboBoxItem Content="Maximum" Tag="maximum" />
                    </ComboBox>

                    <Grid Grid.Row="4"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SmartModeCheckBox"
                                  Grid.Column="0"
                                  Height="22"
                                  Content="Smart mode"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModeCheckBoxStyle}"
                                  Checked="OnSmartModeChanged"
                                  Unchecked="OnSmartModeChanged" />
                        <CheckBox x:Name="ManualModeCheckBox"
                                  Grid.Column="2"
                                  Height="22"
                                  Content="Manual mode"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModeCheckBoxStyle}"
                                  Checked="OnManualModeChanged"
                                  Unchecked="OnManualModeChanged" />
                        <Button x:Name="SettingsButton"
                                Grid.Column="4"
                                MinWidth="120"
                                Height="26"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnSettingsButtonClick">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <controls:SvgIcon Width="14"
                                                  Height="14"
                                                  Margin="0,0,5,0"
                                                  Foreground="{DynamicResource MainTextBrush}"
                                                  Source="/Assets/Icons/settings.svg" />
                                <TextBlock x:Name="SettingsButtonText"
                                           Text="Advanced"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MainTextBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ManualActionsPanel"
                    Width="{Binding ActualWidth, ElementName=MainSettingsPanel}"
                    Background="{DynamicResource DropAreaBackgroundBrush}"
                    BorderBrush="{DynamicResource DropAreaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ManualResultEstimateTextBlock"
                               Margin="0,-6,0,8"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Text=""
                               Foreground="{DynamicResource StatusTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Visibility="Collapsed" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <Button x:Name="CenterCropButton"
                            Grid.Column="0"
                            Height="26"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="OnCenterCropButtonClick">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <controls:SvgIcon Width="16"
                                              Height="16"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource MainTextBrush}"
                                              Source="/Assets/Icons/centered.svg" />
                            <TextBlock x:Name="CenterCropButtonText"
                                       Text="Center"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveManualButton"
                            Grid.Column="2"
                            Height="26"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="OnSaveManualButtonClick">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <controls:SvgIcon Width="14"
                                              Height="14"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource MainTextBrush}"
                                              Source="/Assets/Icons/save.svg" />
                            <TextBlock x:Name="SaveManualButtonText"
                                       Text="Save"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </StackPanel>
                    </Button>
                    </Grid>

                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Width="{Binding ActualWidth, ElementName=MainSettingsPanel}"
                       Height="18"
                       Text=""
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource StatusTextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="11" />
        </StackPanel>
    </Grid>
</Window>
