<Window x:Class="ImageSquareResizer.AboutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="470"
        Height="192"
        MinWidth="470"
        MaxWidth="470"
        MinHeight="192"
        MaxHeight="192"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/app.ico">
    <Grid x:Name="AboutContentRoot"
          Margin="14"
          MouseLeftButtonDown="RootGrid_OnMouseLeftButtonDown">
        <Border Background="{DynamicResource WindowBackgroundBrush}"
                CornerRadius="18"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="4"
                                  Opacity="0.22"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <Border BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Background="{DynamicResource WindowBackgroundBrush}"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="128"
                       Height="128"
                       Source="pack://application:,,,/Assets/squareresizer-about.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       VerticalAlignment="Center" />

                <Grid Grid.Column="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SquareResizer"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="{DynamicResource MainTextBrush}"
                               LineHeight="30"
                               LineStackingStrategy="BlockLineHeight">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform ScaleX="0.96" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>

                    <TextBlock x:Name="VersionTextBlock"
                               Grid.Row="2"
                               FontSize="13.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               LineHeight="17"
                               LineStackingStrategy="BlockLineHeight" />

                    <TextBlock Grid.Row="4"
                               Text="© 2026 DapMark"
                               FontSize="13.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               LineHeight="17"
                               LineStackingStrategy="BlockLineHeight" />

                    <TextBlock Grid.Row="6"
                               FontSize="13.5"
                               Foreground="{DynamicResource AccentBrush}"
                               LineHeight="17"
                               LineStackingStrategy="BlockLineHeight">
                        <Hyperlink x:Name="LicenseLink"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextDecorations="{x:Null}"
                                   Click="LicenseLink_OnClick">
                            <Run x:Name="LicenseLinkRun" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="CloseButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Style="{StaticResource AuxiliaryWindowCloseButtonStyle}"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
