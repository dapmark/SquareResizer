<Window x:Class="ImageSquareResizer.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/app.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FocusVisualStyle="{x:Null}">

    <Window.Resources>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


    </Window.Resources>

    <Grid Margin="28">
        <Border Background="{DynamicResource WindowBackgroundBrush}"
                CornerRadius="10"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="0"
                                  Color="#FF000000"
                                  Opacity="0.36"
                                  RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <Border x:Name="SettingsContentRoot"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="10,10,10,10"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Advanced"
                               Margin="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MainTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Button x:Name="CloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0"
                            Style="{StaticResource AuxiliaryWindowCloseButtonStyle}"
                            Click="CloseButton_OnClick" />
                </Grid>

                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="InterfaceSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Interface" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Language" />
                                <ComboBox x:Name="LanguageComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Width="150"
                                          Height="26"
                                          SelectionChanged="OnLanguageSelectionChanged"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Theme" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Width="150"
                                          Height="26"
                                          SelectionChanged="OnThemeSelectionChanged"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="Dark" Tag="dark" />
                                    <ComboBoxItem Content="Light" Tag="light" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="ShowManualResultEstimateCheckBox"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Show result dimensions and estimated size" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="AdvancedSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Processing" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AutoSizeStepLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Auto size step" />
                                <ComboBox x:Name="AutoSizeStepComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Width="150"
                                          Height="26"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="5 px" Tag="5" />
                                    <ComboBoxItem Content="10 px" Tag="10" />
                                    <ComboBoxItem Content="15 px" Tag="15" />
                                    <ComboBoxItem Content="20 px" Tag="20" />
                                    <ComboBoxItem Content="25 px" Tag="25" />
                                    <ComboBoxItem Content="30 px" Tag="30" />
                                    <ComboBoxItem Content="35 px" Tag="35" />
                                    <ComboBoxItem Content="40 px" Tag="40" />
                                    <ComboBoxItem Content="45 px" Tag="45" />
                                    <ComboBoxItem Content="50 px" Tag="50" />
                                    <ComboBoxItem Content="60 px" Tag="60" />
                                    <ComboBoxItem Content="70 px" Tag="70" />
                                    <ComboBoxItem Content="80 px" Tag="80" />
                                    <ComboBoxItem Content="90 px" Tag="90" />
                                    <ComboBoxItem Content="100 px" Tag="100" />
                                    <ComboBoxItem Content="200 px" Tag="200" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="JpegModeLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="JPEG mode" />
                                <ComboBox x:Name="JpegModeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Width="150"
                                          Height="26"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="Compact" Tag="1" />
                                    <ComboBoxItem Content="Balanced" Tag="2" />
                                    <ComboBoxItem Content="Maximum" Tag="3" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="SmartPaddingSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Smart mode" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SmartPaddingPercentLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Max difference" />
                                <TextBox x:Name="SmartPaddingPercentTextBox"
                                         Grid.Column="1"
                                         Height="26"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         PreviewTextInput="OnDecimalPreviewTextInput"
                                         PreviewKeyDown="OnNumberPreviewKeyDown"
                                         PreviewMouseWheel="OnSmartPaddingPercentPreviewMouseWheel"
                                         TextChanged="OnValidationTextChanged" />
                                <TextBlock Grid.Column="2"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="%" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SmartPaddingMaxPxLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Max fill" />
                                <TextBox x:Name="SmartPaddingMaxPxTextBox"
                                         Grid.Column="1"
                                         Height="26"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         PreviewTextInput="OnIntegerPreviewTextInput"
                                         PreviewKeyDown="OnNumberPreviewKeyDown"
                                         PreviewMouseWheel="OnSmartPaddingMaxPxPreviewMouseWheel"
                                         TextChanged="OnValidationTextChanged" />
                                <TextBlock Grid.Column="2"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="px" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ValidationStatusTextBlock"
                               Grid.Row="3"
                               Height="18"
                               Margin="0,0,0,4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource StatusErrorTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AboutButton"
                                Grid.Column="0"
                                Height="26"
                                Style="{StaticResource AuxiliaryButtonStyle}"
                                Content="About"
                                Click="OnAboutButtonClick" />
                        <Button x:Name="ResetButton"
                                Grid.Column="2"
                                Height="26"
                                Style="{StaticResource AuxiliaryButtonStyle}"
                                Content="Reset"
                                Click="OnResetButtonClick" />
                        <Button x:Name="SaveButton"
                                Grid.Column="4"
                                Height="26"
                                Style="{StaticResource AuxiliaryApplyButtonStyle}"
                                Content="Apply"
                                Click="OnSaveButtonClick" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
