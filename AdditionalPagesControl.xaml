<UserControl x:Class="ImageSquareResizer.AdditionalPagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:ImageSquareResizer.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             UseLayoutRounding="True"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="LabelTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AboutLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RenderOptions.ClearTypeHint="Enabled" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicenseScrollThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid Background="Transparent"
                              ClipToBounds="False"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True">
                            <Border x:Name="ThumbCapsule"
                                    Width="4"
                                    MinHeight="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True">
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCapsule" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbCapsule" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicenseScrollTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="LicenseVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent"
                  ClipToBounds="False"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <primitives:Track x:Name="PART_Track"
                                  Focusable="False"
                                  IsDirectionReversed="True">
                    <primitives:Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                      Style="{StaticResource LicenseScrollTrackButtonStyle}" />
                    </primitives:Track.DecreaseRepeatButton>
                    <primitives:Track.Thumb>
                        <primitives:Thumb MinHeight="6"
                                          Style="{StaticResource LicenseScrollThumbStyle}" />
                    </primitives:Track.Thumb>
                    <primitives:Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                      Style="{StaticResource LicenseScrollTrackButtonStyle}" />
                    </primitives:Track.IncreaseRepeatButton>
                </primitives:Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="LicenseContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicenseMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Header}"
                                       RenderOptions.ClearTypeHint="Enabled" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemRoot" Property="Background" Value="{DynamicResource SoftButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12,0,12,12">
        <Border x:Name="SettingsContentRoot"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderThickness="0"
                RenderOptions.ClearTypeHint="Enabled"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid x:Name="SettingsPageGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="10,9,10,10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="InterfaceSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Interface" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Language" />
                                <ComboBox x:Name="LanguageComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Height="26"
                                          SelectionChanged="OnLanguageSelectionChanged"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Theme" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Height="26"
                                          SelectionChanged="OnThemeSelectionChanged"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="Dark" Tag="dark" />
                                    <ComboBoxItem Content="Light" Tag="light" />
                                </ComboBox>
                            </Grid>

                            <!-- The result dimensions and estimated size are always shown.
                            <CheckBox x:Name="ShowManualResultEstimateCheckBox"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Show result dimensions and estimated size" />
                            -->
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10,9,10,10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="AdvancedSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Processing" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AutoSizeStepLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Auto size step" />
                                <ComboBox x:Name="AutoSizeStepComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Height="26"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="5 px" Tag="5" />
                                    <ComboBoxItem Content="10 px" Tag="10" />
                                    <ComboBoxItem Content="15 px" Tag="15" />
                                    <ComboBoxItem Content="20 px" Tag="20" />
                                    <ComboBoxItem Content="25 px" Tag="25" />
                                    <ComboBoxItem Content="30 px" Tag="30" />
                                    <ComboBoxItem Content="35 px" Tag="35" />
                                    <ComboBoxItem Content="40 px" Tag="40" />
                                    <ComboBoxItem Content="45 px" Tag="45" />
                                    <ComboBoxItem Content="50 px" Tag="50" />
                                    <ComboBoxItem Content="60 px" Tag="60" />
                                    <ComboBoxItem Content="70 px" Tag="70" />
                                    <ComboBoxItem Content="80 px" Tag="80" />
                                    <ComboBoxItem Content="90 px" Tag="90" />
                                    <ComboBoxItem Content="100 px" Tag="100" />
                                    <ComboBoxItem Content="200 px" Tag="200" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="JpegModeLabel"
                                           Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="JPEG mode" />
                                <ComboBox x:Name="JpegModeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Height="26"
                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel">
                                    <ComboBoxItem Content="Compact" Tag="1" />
                                    <ComboBoxItem Content="Balanced" Tag="2" />
                                    <ComboBoxItem Content="Maximum" Tag="3" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="OnlineServiceCompatibilityCheckBox"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Improve compatibility with online services" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,0,0,10"
                            Padding="10,9,10,10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="SmartPaddingSectionTextBlock"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="Smart mode" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SmartPaddingPercentLabel"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Max difference, %" />
                                <TextBox x:Name="SmartPaddingPercentTextBox"
                                         Grid.Column="2"
                                         Height="26"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         PreviewTextInput="OnDecimalPreviewTextInput"
                                         PreviewKeyDown="OnNumberPreviewKeyDown"
                                         PreviewMouseWheel="OnSmartPaddingPercentPreviewMouseWheel"
                                         TextChanged="OnValidationTextChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SmartPaddingMaxPxLabel"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="Max fill, px" />
                                <TextBox x:Name="SmartPaddingMaxPxTextBox"
                                         Grid.Column="2"
                                         Height="26"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         PreviewTextInput="OnIntegerPreviewTextInput"
                                         PreviewKeyDown="OnNumberPreviewKeyDown"
                                         PreviewMouseWheel="OnSmartPaddingMaxPxPreviewMouseWheel"
                                         TextChanged="OnValidationTextChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,0,0,10"
                            Padding="10,9,10,10"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="WindowsIntegrationSectionTextBlock"
                                           Margin="0"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Text="Windows integration" />

                                <TextBlock x:Name="WindowsIntegrationInfoTextBlock"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="11" />
                            </Grid>

                            <CheckBox x:Name="ContextMenuIntegrationCheckBox"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Resize command in context menu"
                                      Click="OnWindowsIntegrationCheckBoxClick" />

                            <CheckBox x:Name="ManualContextMenuIntegrationCheckBox"
                                      Margin="0,8,0,0"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Manual mode in context menu"
                                      Click="OnWindowsIntegrationCheckBoxClick" />

                            <CheckBox x:Name="SendToIntegrationCheckBox"
                                      Margin="0,8,0,0"
                                      Style="{StaticResource ModeCheckBoxStyle}"
                                      Content="Shortcut in the Send to menu"
                                      Click="OnWindowsIntegrationCheckBoxClick" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ValidationStatusTextBlock"
                               Grid.Row="4"
                               Height="18"
                               Margin="0,0,0,4"
                               Visibility="Collapsed"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource StatusErrorTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11" />

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AboutButton"
                                Grid.Column="0"
                                Height="26"
                                Style="{StaticResource AuxiliaryButtonStyle}"
                                Click="OnAboutButtonClick">
                            <TextBlock x:Name="AboutButtonText"
                                       Text="About"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </Button>
                        <Button x:Name="ResetButton"
                                Grid.Column="2"
                                Height="26"
                                Style="{StaticResource AuxiliaryButtonStyle}"
                                Click="OnResetButtonClick">
                            <TextBlock x:Name="ResetButtonText"
                                       Text="Reset"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </Button>
                        <Button x:Name="SaveButton"
                                Grid.Column="4"
                                Height="26"
                                Style="{StaticResource AuxiliaryApplyButtonStyle}"
                                Click="OnSaveButtonClick">
                            <TextBlock x:Name="ApplyButtonText"
                                       Text="Apply"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="AboutPageGrid"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Image Width="256"
                               Height="256"
                               HorizontalAlignment="Center"
                               Source="pack://application:,,,/Assets/squareresizer-about.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />

                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Text="SquareResizer"
                                   Foreground="{DynamicResource MainTextBrush}"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="24"
                                   FontWeight="Black"
                                   TextAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="0.96" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>

                        <TextBlock x:Name="AboutVersionTextBlock"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="13.5"
                                   TextAlignment="Center" />

                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Text="© 2026 DapMark"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="13.5"
                                   TextAlignment="Center" />

                        <Button x:Name="LicenseButton"
                                Margin="0,6,0,0"
                                Style="{StaticResource AboutLinkButtonStyle}"
                                Content="License and third-party components"
                                Click="LicenseButton_OnClick" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LicensePageGrid"
                      Background="Transparent"
                      PreviewMouseWheel="LicensePageGrid_OnPreviewMouseWheel"
                      PreviewMouseRightButtonUp="LicensePageGrid_OnPreviewMouseRightButtonUp"
                      Visibility="Collapsed">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="LicenseContextMenu"
                                     Style="{StaticResource LicenseContextMenuStyle}"
                                     Opened="LicenseContextMenu_OnOpened">
                            <MenuItem x:Name="LicenseCopyMenuItem"
                                      Style="{StaticResource LicenseMenuItemStyle}"
                                      Header="Copy"
                                      Click="LicenseCopyMenuItem_OnClick" />
                            <MenuItem x:Name="LicenseSelectAllMenuItem"
                                      Style="{StaticResource LicenseMenuItemStyle}"
                                      Header="Select all"
                                      Click="LicenseSelectAllMenuItem_OnClick" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid Margin="7,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>

                            <controls:LicenseTextViewer x:Name="LicenseTextViewer"
                                                        Grid.Column="0"
                                                        Margin="0,0,3,0"
                                                        Foreground="{DynamicResource MainTextBrush}"
                                                        SelectionBrush="{DynamicResource AccentBorderBrush}"
                                                        FontFamily="Segoe UI"
                                                        FontSize="13"
                                                        SizeChanged="LicenseTextViewer_OnSizeChanged" />

                            <ScrollBar x:Name="LicenseScrollBar"
                                       Grid.Column="1"
                                       Width="10"
                                       Height="Auto"
                                       Background="Transparent"
                                       Focusable="False"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Stretch"
                                       ClipToBounds="False"
                                       UseLayoutRounding="True"
                                       SnapsToDevicePixels="True"
                                       Orientation="Vertical"
                                       Template="{StaticResource LicenseVerticalScrollBarTemplate}"
                                       ValueChanged="LicenseScrollBar_OnValueChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
